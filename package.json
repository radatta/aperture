{
  "name": "aperture",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @aperture/app dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "tsc -b",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache --cache-strategy content",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache --cache-strategy content",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "devcheck": "pnpm --filter @aperture/scripts devcheck",
    "bot": "node scripts/src/bot/cli.ts",
    "mailroom": "node scripts/src/mailroom/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "esbuild": "0.28.1",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
