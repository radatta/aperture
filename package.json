{
  "name": "aperture",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @aperture/app dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "tsc -b",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache --cache-strategy content",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache --cache-strategy content",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate:fast": "node scripts/src/gate/cli.ts",
    "gate:ci": "node scripts/src/gate/ci.ts",
    "devcheck": "pnpm --filter @aperture/scripts devcheck",
    "devcheck:local": "pnpm --filter @aperture/scripts devcheck:local",
    "devcheck:cost": "node scripts/src/devcheck/read-cost-cli.ts",
    "ios-probe": "pnpm --filter @aperture/scripts ios-probe",
    "sim-bench:plans": "pnpm --filter @aperture/scripts sim-bench:plans",
    "sim-bench:seed": "pnpm --filter @aperture/scripts sim-bench:seed",
    "board": "node scripts/src/board/cli.ts",
    "claude-edit": "node scripts/src/claude-edit/cli.ts",
    "bot": "node scripts/src/bot/cli.ts",
    "mailroom": "node scripts/src/mailroom/cli.ts",
    "lanes": "node scripts/src/lane/cli.ts",
    "usage": "node scripts/src/usage/cli.ts",
    "plan-lint": "node scripts/src/plan-lint/cli.ts",
    "vapid-keys": "node scripts/src/vapid-keys.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "esbuild": "0.28.1",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
