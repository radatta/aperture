<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered twice by tools/mailroom/install.sh into ~/Library/LaunchAgents/, once per lane (slow, fast). The path
     @…@ fields are absolute; @LABEL@, @LANE@ and @THROTTLE@ are the lane's. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@LABEL@</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@RUNNER@</string>
    <string>@HOSTJOBS@</string>
    <string>@STATE@</string>
    <string>@LANE@</string>
  </array>
@TRIGGER@
  <key>ThrottleInterval</key>
  <integer>@THROTTLE@</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>@LOG@</string>
  <key>StandardErrorPath</key>
  <string>@LOG@</string>
  <key>ExitTimeOut</key>
  <integer>120</integer>
</dict>
</plist>
