{"expect": "deny", "reason": "no ledger", "why": "no ledger yet \u2014 fail closed", "input": {"id": "t1"}}
{"expect": "allow", "why": "the id was recorded from a create response", "input": {"id": "t1"}, "ledger": [{"t": "x", "op": "created", "id": "t1", "via": "mcp:create_task"}]}
{"expect": "deny", "reason": "t2 was never recorded", "why": "an id the ledger doesn't know \u2014 e.g. one of the user's own dev tasks", "input": {"id": "t2"}, "ledger": [{"t": "x", "op": "created", "id": "t1", "via": "mcp:create_task"}]}
{"expect": "deny", "reason": "never recorded", "why": "a 'deleted' line alone is not a create", "input": {"id": "t3"}, "ledger": [{"t": "x", "op": "deleted", "id": "t3"}]}
{"expect": "deny", "reason": "no id", "why": "no id in the call", "input": {}, "ledger": [{"t": "x", "op": "created", "id": "t1"}]}
{"expect": "allow", "why": "prod deletes aren't this hook's business \u2014 the per-write approval rule covers them", "tool": "mcp__aperture__delete_task", "input": {"id": "t9"}}
{"expect": "allow", "why": "PostToolUse create_task: content-block result \u2192 created line", "tool": "mcp__aperture-dev__create_task", "input": {"title": "x"}, "payload": {"hook_event_name": "PostToolUse", "session_id": "s1", "tool_response": {"content": [{"type": "text", "text": "{\"id\":\"t9\",\"title\":\"x\"}"}]}}, "expect_ledger": ["created:t9"], "ledger_count": 1}
{"expect": "allow", "why": "PostToolUse create_tasks: bare content-block array \u2192 one line per task", "tool": "mcp__aperture-dev__create_tasks", "input": {"tasks": []}, "payload": {"hook_event_name": "PostToolUse", "tool_response": [{"type": "text", "text": "[{\"id\":\"a\"},{\"id\":\"b\"}]"}]}, "expect_ledger": ["created:a", "created:b"], "ledger_count": 2}
{"expect": "allow", "why": "PostToolUse delete_task: the id and the parts deleted with it", "tool": "mcp__aperture-dev__delete_task", "input": {"id": "t1"}, "payload": {"hook_event_name": "PostToolUse", "tool_response": {"content": [{"type": "text", "text": "{\"deleted\":\"t1\",\"parts\":[\"p1\",\"p2\"]}"}]}}, "ledger": [{"t": "x", "op": "created", "id": "t1"}], "expect_ledger": ["created:t1", "deleted:t1", "deleted:p1", "deleted:p2"], "ledger_count": 4}
{"expect": "allow", "why": "an error result (plain text) records nothing", "tool": "mcp__aperture-dev__create_task", "input": {"title": "x"}, "payload": {"hook_event_name": "PostToolUse", "tool_response": {"content": [{"type": "text", "text": "title is required"}]}}, "ledger_count": 0}
{"expect": "allow", "why": "a prod create is never recorded", "tool": "mcp__aperture__create_task", "input": {"title": "x"}, "payload": {"hook_event_name": "PostToolUse", "tool_response": {"id": "prod1"}}, "ledger_count": 0}
{"expect": "allow", "tool": "mcp__aperture-dev__split_task", "input": {"id": "o"}, "payload": {"hook_event_name": "PostToolUse", "tool_response": {"parent": {"id": "p"}, "original": {"id": "o"}, "followUp": {"id": "f"}}}, "why": "split of a recorded standalone task: its new parent and the follow-up are recorded, the original moves under it", "ledger": [{"t": "x", "op": "created", "id": "o"}], "expect_ledger": ["created:p", "created:f", "reparented:o"], "ledger_count": 4}
{"expect": "allow", "tool": "mcp__aperture-dev__split_task", "input": {"id": "o"}, "payload": {"hook_event_name": "PostToolUse", "tool_response": {"parent": {"id": "p"}, "original": {"id": "o"}, "followUp": {"id": "f"}}}, "why": "split of an unrecorded task: only the follow-up \u2014 the parent may hold the user's tasks", "expect_ledger": ["created:f"], "ledger_count": 1}
{"expect": "allow", "tool": "mcp__aperture-dev__split_task", "input": {"id": "o"}, "payload": {"hook_event_name": "PostToolUse", "tool_response": {"parent": {"id": "p"}, "original": {"id": "o"}, "followUp": {"id": "f"}}}, "why": "split of a recorded part: the parent already existed \u2014 not recorded as created", "ledger": [{"t": "x", "op": "created", "id": "o", "parent": "p"}], "expect_ledger": ["created:f"], "ledger_count": 2}
{"expect": "allow", "tool": "mcp__aperture-dev__split_task", "input": {"id": "o"}, "payload": {"hook_event_name": "PostToolUse", "tool_response": {"parent": {"id": "p"}, "original": {"id": "o"}, "followUp": {"id": "f"}}}, "why": "split of an unrecorded part under a recorded parent: the parent is tainted", "ledger": [{"t": "x", "op": "created", "id": "p"}], "expect_ledger": ["tainted:p", "created:f"], "ledger_count": 3}
{"expect": "allow", "tool": "mcp__aperture-dev__create_tasks", "input": {"tasks": []}, "payload": {"hook_event_name": "PostToolUse", "tool_response": [{"type": "text", "text": "[{\"id\":\"c1\",\"parentId\":\"p\"}]"}]}, "why": "create_tasks keeps each part's parent", "expect_ledger": ["created:c1"], "ledger_count": 1}
{"expect": "deny", "reason": "has a part this hook never recorded", "why": "a tainted parent can't be deleted \u2014 the cascade would take the user's part", "input": {"id": "p"}, "ledger": [{"t": "x", "op": "created", "id": "p"}, {"t": "x", "op": "tainted", "id": "p"}]}
{"expect": "deny", "reason": "never recorded", "why": "no event name is treated as the Pre check, never as allow", "input": {"id": "t2"}, "payload": {"hook_event_name": ""}, "ledger": [{"t": "x", "op": "created", "id": "t1"}]}
{"expect": "allow", "tool": "mcp__aperture-dev__update_task", "why": "Pre: attaching an unrecorded task under a recorded parent taints it before the call (the call can half-apply)", "input": {"id": "u1", "parentId": "p", "status": "done"}, "ledger": [{"t": "x", "op": "created", "id": "p"}], "expect_ledger": ["tainted:p"], "ledger_count": 2}
{"expect": "allow", "tool": "mcp__aperture-dev__update_task", "why": "Pre: attaching a recorded task is recorded before the call", "input": {"id": "t1", "parentId": "q"}, "ledger": [{"t": "x", "op": "created", "id": "t1"}], "expect_ledger": ["reparented:t1"], "ledger_count": 2}
{"expect": "allow", "tool": "mcp__aperture-dev__update_task", "why": "Pre: attaching an unrecorded task under an unrecorded parent records nothing", "input": {"id": "u1", "parentId": "q"}, "ledger": [{"t": "x", "op": "created", "id": "t1"}], "ledger_count": 1}
{"expect": "allow", "tool": "mcp__aperture-dev__update_task", "why": "Pre: a corrupt ledger reads as unknown \u2014 the parent is tainted, never trusted", "input": {"id": "u1", "parentId": "p"}, "ledger": [{"t": "x", "op": "created", "id": "p"}, "{not json"], "expect_ledger": ["tainted:p"], "ledger_count": 3}
{"expect": "allow", "tool": "mcp__aperture-dev__update_task", "why": "Post: a successful detach of a recorded task is recorded", "input": {"id": "t1", "parentId": null}, "payload": {"hook_event_name": "PostToolUse", "tool_response": {"id": "t1"}}, "ledger": [{"t": "x", "op": "created", "id": "t1", "parent": "p"}], "expect_ledger": ["reparented:t1"], "ledger_count": 2}
{"expect": "allow", "tool": "mcp__aperture-dev__update_task", "why": "Post: an attach is not recorded twice (Pre did it)", "input": {"id": "t1", "parentId": "p"}, "payload": {"hook_event_name": "PostToolUse", "tool_response": {"id": "t1"}}, "ledger": [{"t": "x", "op": "created", "id": "t1"}, {"t": "x", "op": "reparented", "id": "t1", "parent": "p"}], "ledger_count": 2}
{"expect": "allow", "tool": "mcp__aperture-dev__update_task", "why": "Post: an update without parentId records nothing", "input": {"id": "t1", "title": "x"}, "payload": {"hook_event_name": "PostToolUse", "tool_response": {"id": "t1"}}, "ledger": [{"t": "x", "op": "created", "id": "t1"}], "ledger_count": 1}
{"expect": "allow", "tool": "mcp__aperture-dev__split_task", "why": "split of a recorded task that Pre saw attached elsewhere: that parent existed \u2014 not recorded as created", "input": {"id": "o"}, "payload": {"hook_event_name": "PostToolUse", "tool_response": {"parent": {"id": "p"}, "original": {"id": "o"}, "followUp": {"id": "f"}}}, "ledger": [{"t": "x", "op": "created", "id": "o"}, {"t": "x", "op": "reparented", "id": "o", "parent": "p"}], "expect_ledger": ["created:f"], "ledger_count": 3}
{"expect": "deny", "reason": "unreadable", "why": "a corrupt ledger denies every delete", "input": {"id": "p"}, "ledger": [{"t": "x", "op": "created", "id": "p"}, "{not json"]}
{"expect": "allow", "tool": "mcp__aperture-dev__split_task", "why": "split with a corrupt ledger: the parent is tainted, never recorded as created", "input": {"id": "o"}, "payload": {"hook_event_name": "PostToolUse", "tool_response": {"parent": {"id": "p"}, "original": {"id": "o"}, "followUp": {"id": "f"}}}, "ledger": [{"t": "x", "op": "created", "id": "o"}, "{not json"], "expect_ledger": ["tainted:p", "created:f"]}
{"expect": "allow", "tool": "mcp__aperture-dev__update_task", "why": "the session's cwd is outside the repo \u2014 the attach still taints the right ledger", "input": {"id": "u1", "parentId": "p"}, "payload": {"cwd": "/tmp"}, "ledger": [{"t": "x", "op": "created", "id": "p"}], "expect_ledger": ["tainted:p"], "ledger_count": 2}
{"expect": "allow", "tool": "mcp__aperture-dev__update_task", "why": "Pre: a detach is never recorded before the call", "input": {"id": "t1", "parentId": null}, "ledger": [{"t": "x", "op": "created", "id": "t1", "parent": "p"}], "ledger_count": 1}
{"expect": "allow", "tool": "mcp__aperture-dev__update_task", "why": "Post: a detach of an unrecorded task records nothing", "input": {"id": "u1", "parentId": null}, "payload": {"hook_event_name": "PostToolUse", "tool_response": {"id": "u1"}}, "ledger": [{"t": "x", "op": "created", "id": "t1"}], "ledger_count": 1}
{"expect": "allow", "tool": "mcp__aperture-dev__split_task", "why": "split after a recorded detach: the task is standalone again, so the new parent is recorded", "input": {"id": "o"}, "payload": {"hook_event_name": "PostToolUse", "tool_response": {"parent": {"id": "p"}, "original": {"id": "o"}, "followUp": {"id": "f"}}}, "ledger": [{"t": "x", "op": "created", "id": "o", "parent": "q"}, {"t": "x", "op": "reparented", "id": "o"}], "expect_ledger": ["created:p", "created:f", "reparented:o"], "ledger_count": 5}
